{
  "name": "@edss/auth",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./store": {
      "types": "./src/store.ts",
      "default": "./src/store.ts"
    },
    "./hooks": {
      "types": "./src/hooks.ts",
      "default": "./src/hooks.ts"
    },
    "./guard": {
      "types": "./src/guard.tsx",
      "default": "./src/guard.tsx"
    },
    "./session": {
      "types": "./src/session.ts",
      "default": "./src/session.ts"
    },
    "./2fa": {
      "types": "./src/2fa.ts",
      "default": "./src/2fa.ts"
    },
    "./client": {
      "types": "./src/client.ts",
      "default": "./src/client.ts"
    }
  },
  "dependencies": {
    "@edss/api": "*",
    "@edss/types": "*",
    "@edss/validation": "*",
    "zustand": "^5.0.2"
  },
  "peerDependencies": {
    "react": "^19",
    "next": "^15"
  },
  "devDependencies": {
    "@edss/config": "*",
    "@types/react": "^19.0.2",
    "typescript": "^5.7.2"
  }
}
