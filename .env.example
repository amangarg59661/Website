NEXT_PUBLIC_SITE_URL=https://elitedigital.studio
NEXT_PUBLIC_WHATSAPP_NUMBER=910000000000
CONTACT_EMAIL=hello@elitedigital.studio
RESEND_API_KEY=

# Analytics — PostHog Cloud EU (locked 2026-07-06 for Indian user base)
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com

# Dashboard
# M-03: backend controllers are under /api/v1/*. NEXT_PUBLIC_API_BASE must
# include that prefix so BFF proxies and client-side apiFetch both compose
# correct URLs. If the deployment ever moves to a different version prefix,
# change the env — not the code.
NEXT_PUBLIC_API_BASE=https://api.edss.example/api/v1
# WebSocket STOMP endpoint served by Spring at /ws/v1 (see backend
# WebSocketConfig). Client library composes ${WS_BASE}/ws/v1.
NEXT_PUBLIC_WS_BASE=wss://api.edss.example
# Development only. Never set to true in production — the MSWProvider throws
# at boot if this is truthy with NODE_ENV=production. Local devs opt in by
# copying this file to .env.local and flipping to true.
NEXT_PUBLIC_USE_MOCKS=false
NEXT_PUBLIC_2FA_ENABLED=false

# Rate limit (Vercel edge — Upstash Redis)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

CSP_REPORT_LOG_LEVEL=info
